# Dependencies
node_modules/

# Build output. GitHub Actions builds this fresh on every push and uploads it
# over FTPS, so it must NOT be committed — a stale committed copy would only
# create confusion about which build is live.
dist/

# Env / secrets — never commit
.env
.env.*
*.token

# Logs & OS cruft
*.log
.DS_Store
Thumbs.db

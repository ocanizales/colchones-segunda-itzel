# Dependencies
node_modules/

# NOTE: dist/ is deliberately COMMITTED. cPanel's Git Version Control only
# copies files — it cannot run a build — so the compiled output has to be in
# the repo for it to have anything to deploy. Always `npm run build` before
# committing; CI fails the push if dist/ is stale.

# Env / secrets — never commit
.env
.env.*
*.token

# Logs & OS cruft
*.log
.DS_Store
Thumbs.db
